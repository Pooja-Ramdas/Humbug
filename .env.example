# Humbug — environment variable reference
# Copy this to .env and edit as needed. None of these are required for a
# default local run: docker compose up works with no .env at all.
#
# Variables are read by docker-compose.yml; the backend reads DB_PATH directly.

# ── Backend ─────────────────────────────────────────────────────────────

# Path to the SQLite database inside the container.
# Default: /app/data/data.db (matches the humbug-data volume mount)
# Change this only if you mount data to a different path.
DB_PATH=/app/data/data.db

# Seed for the synthetic network generator.
# Changing the seed regenerates a different topology on first startup.
# Only takes effect if data.db does not already exist.
# Default: 42
GENERATE_SEED=42

# ── Frontend ─────────────────────────────────────────────────────────────

# The URL the browser uses to reach the backend.
# In production (behind nginx), the frontend proxies /api → backend:8000,
# so this does NOT need to be set. It is only relevant for local dev
# when running the frontend outside Docker (e.g. opening index.html directly).
#
# For local dev without Docker:
#   HUMBUG_API_BASE=http://localhost:8000
#
# Default when served by nginx: /api  (set by app.js at boot)
# HUMBUG_API_BASE=http://localhost:8000

# ── Deployment notes ────────────────────────────────────────────────────
# See DEPLOYMENT.md for full instructions including Railway/Render/Fly.io options.
