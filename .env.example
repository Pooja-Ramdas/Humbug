# Humbug — Environment Variable Reference
# Copy this file to .env to customize settings.

# ── Backend Configuration ──────────────────────────────────────────────
# Path to the SQLite database file.
# In Docker: /app/data/data.db
# Local dev: data/data.db
DB_PATH=/app/data/data.db

# Seed for the synthetic network generator (2,750 poles, 250 transformers).
GENERATE_SEED=42

# Backend server host and port (for standalone server.py or uvicorn)
HOST=0.0.0.0
PORT=8000

# ── Frontend Configuration ─────────────────────────────────────────────
# Base URL for API calls from browser.
# In production (nginx proxy): /api
# Local standalone frontend: http://localhost:8000
HUMBUG_API_BASE=http://localhost:8000
